{
  "name": "canvaskit",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "turbo run build",
    "build:release": "pnpm --filter @canvaskit/geometry build && pnpm --filter @canvaskit/core build && pnpm --filter @canvaskit/collaboration-adapters build && pnpm --filter @canvaskit/plugins build && pnpm --filter @canvaskit/renderer-canvas build && pnpm --filter @canvaskit/renderer-svg build && pnpm --filter @canvaskit/renderer-pdf build && pnpm --filter @canvaskit/accessibility build && pnpm --filter @canvaskit/react build && pnpm --filter @canvaskit/vue build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test": "vitest run",
    "typecheck": "turbo run typecheck",
    "test:e2e": "playwright test",
    "storybook": "storybook dev --config-dir .storybook --port 6006",
    "storybook:build": "storybook build --config-dir .storybook",
    "storybook:vue": "storybook dev --config-dir .storybook-vue --port 6007",
    "storybook:vue:build": "storybook build --config-dir .storybook-vue",
    "benchmark:spatial-index": "node --experimental-strip-types benchmarks/spatial-index.ts",
    "test:release": "node --test scripts/release-readiness.test.mjs && node scripts/release-readiness.mjs",
    "bundle:size": "node scripts/bundle-size.mjs",
    "test:bundle-size": "node --test scripts/bundle-size.test.mjs",
    "verify:release-quality": "pnpm build:release && pnpm test:bundle-size && pnpm bundle:size && pnpm benchmark:spatial-index",
    "test:pack": "node --test scripts/package-smoke.test.mjs && node scripts/package-smoke.mjs",
    "publish:dry-run": "pnpm build:release && pnpm test:release && pnpm test:pack"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@storybook/vue3": "^8.6.18",
    "@storybook/vue3-vite": "^8.6.18",
    "@testing-library/react": "^16.3.2",
    "@testing-library/vue": "^8.1.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^8.6.18",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitepress": "^1.6.3",
    "vitest": "^3.2.0",
    "vue": "^3.5.41"
  }
}
